EXPO_PUBLIC_API_BASE_URL=https://trlm.pickitover.com/api
EXPO_PUBLIC_CRP_SIGNUP_PATH=/api/auth/crp/signup
EXPO_PUBLIC_LOGIN_PATH=/api/auth/crp/login
EXPO_PUBLIC_CATEGORY_PATH=/api/category/get-all
EXPO_PUBLIC_CRP_TYPES_PATH=/api/crptype
EXPO_PUBLIC_CRP_ATTENDANCE_CHECKIN_PATH=/api/crp-attendance/checkin
EXPO_PUBLIC_ACTIVITY_PATH=/api/activity
EXPO_PUBLIC_SUBCATEGORY_BY_ACTIVITY_PATH=/api/subcategory/by-activity
EXPO_PUBLIC_ALL_CRPS_PATH=/api/auth/crp/all
EXPO_PUBLIC_LIVELIHOOD_PATH=/api/livelihood
EXPO_PUBLIC_SHG_TRACKING_PATH=/api/shg-tracking/save
# Required for live translation (Bengali/Hindi/Assamese/etc.) of dashboard
# text that has no pre-written entry in src/i18n/locales/*.json. Get a key
# from Google Cloud Console (enable the "Cloud Translation API") and paste
# it here - without it, translateBatch() in src/i18n/googleTranslate.js
# silently falls back to English for any text not in the static dictionaries.
EXPO_PUBLIC_GOOGLE_TRANSLATE_API_KEY=
